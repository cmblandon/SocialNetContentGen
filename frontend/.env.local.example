# Copy to .env.local (gitignored) and fill in real values.

# Base URL of the editorial FastAPI service (src/editorial/presentation/app.py).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Shared access token for the admin panel (design.md: single shared token,
# not per-user accounts). Pick any long random string. Whoever knows this
# token can log in — treat it like a password.
ADMIN_PANEL_TOKEN=change-me
